# =====================================================================
# atom-erp 운영 환경 파일 양식 (deploy/prod/run-erp.sh · run-erp.ps1 이 읽음). 비밀값은 비워 두고 서버에서만 채운다.
# 이 양식을 복사해 /etc/atom-erp/erp.env(권한 600, 서비스 계정 전용)로 두고 값을 채운다. 저장소에 실제 값 커밋 금지.
# SPRING_PROFILES_ACTIVE 는 여기에 쓰지 않는다 — 기동기가 항상 prod 로 고정한다(CMN-04).
# =====================================================================

# DB (CMN-13: 비어 있거나 개발 기본값이면 기동 실패)
PG_HOST=
PG_PORT=5432
PG_DB=atom_erp
PG_APP_USER=atom_app
PG_APP_PASSWORD=

# Keycloak OIDC (CMN-06)
KEYCLOAK_URL=
ATOM_SECURITY_AUDIENCES=atom-erp-api

# 증거 · 발행본 저장소 — S3 호환 Object Lock(COMPLIANCE) (CMN-07). 버킷은 Object Lock 을 켜고 만들어야 한다.
ATOM_EVIDENCE_S3_ENDPOINT=
ATOM_EVIDENCE_S3_REGION=us-east-1
ATOM_EVIDENCE_S3_ACCESS_KEY=
ATOM_EVIDENCE_S3_SECRET_KEY=

# AIP 워커(선택, AIP-06: 32바이트 이상)
ATOM_AIP_WORKER_URL=
ATOM_AIP_WORKER_SECRET=

# 서버 렌더 · 외부 연동(선택)
GOTENBERG_URL=
G2B_SERVICE_KEY=
